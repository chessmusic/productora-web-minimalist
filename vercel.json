{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "laprodufilms.com" }
      ],
      "destination": "https://www.laprodufilms.com/:path*",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/laprodu/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
